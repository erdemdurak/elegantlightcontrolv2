<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Elegant Light</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Allow Elegant Light Control to find and connect to your BLE ambient controller.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Allow Elegant Light Control to communicate with your BLE ambient controller.</string>
	<!-- No NSLocationWhenInUseUsageDescription: iOS BLE central needs no location permission,
	     and an empty purpose string is rejected on submission. Android is where the location
	     permission lives — see bleAmbientController.requestAndroidPermissions. -->
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<!-- Both roles must be declared. With only the CarPlay role the app still moves onto
			     the scene lifecycle but has no delegate to display the phone window, which is what
			     produced a blank screen. Configuration names match AppDelegate's
			     configurationForConnecting. -->
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Phone</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Lets BLE work while backgrounded, and lets iOS restore the connection. -->
		<string>bluetooth-central</string>
		<!-- No `audio`. It was here so BackgroundKeepAlive.swift could hold a silent audio
		     session, which kept the JS runtime alive for phone-driven effects and for CarPlay
		     taps while the phone slept. App Store guideline 2.5.4 forbids exactly that — using
		     a background service for something other than its stated purpose — and silent
		     playback to stay awake is the textbook case. Removing it costs backgrounded
		     gradient/strobe, and costs CarPlay taps landing while the app is suspended. The
		     real fix is a native CoreBluetooth path (Task 1c), not this key.
		     See docs/app-store-submission.md. -->
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
